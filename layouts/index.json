{{- $index := slice -}}

{{- with site.GetPage "section" "posts" -}}
  {{- range .Sections -}}
    {{- if and (not .Draft) (gt (len .RegularPages) 0) -}}
      {{- $index = $index | append (dict
        "id" .RelPermalink
        "title" .Title
        "content" (replaceRE `\s+` " " (or .Plain .Description) | chomp)
        "tags" (.Params.tags | default slice)
        "html" (partial "ui/section-card.html" .)
      ) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- range where (where site.RegularPages "Type" "posts") "Draft" false -}}
  {{- $index = $index | append (dict
    "id" .RelPermalink
    "title" .Title
    "content" (replaceRE `\s+` " " .Plain | chomp)
    "tags" (.Params.tags | default slice)
    "html" (.Render "summary")
  ) -}}
{{- end -}}

{{- $index | jsonify -}}
