{{- $index := slice -}}

{{- /* Предметы: одна запись на группу, а не на каждую папку-вариант.
       В content попадают ещё и фамилии преподавателей — чтобы поиск
       по «Соколова» находил предмет. */ -}}
{{- range partialCached "utils/subject-groups.html" . "cn-all-groups" -}}
  {{- $g := . -}}
  {{- $text := slice (delimit $g.teachers " ") -}}
  {{- range $g.variants -}}
    {{- $text = $text | append (delimit .authors " ") -}}
    {{- $text = $text | append .year -}}
    {{- $text = $text | append (replaceRE `\s+` " " (or .page.Plain (string .page.Description)) | chomp) -}}
  {{- end -}}

  {{- $index = $index | append (dict
    "id" $g.primary.RelPermalink
    "title" $g.title
    "content" (chomp (replaceRE `\s+` " " (delimit $text " ")))
    "tags" ($g.primary.Params.tags | default slice)
    "html" (partial "ui/section-card.html" $g)
  ) -}}
{{- end -}}

{{- range where (where site.RegularPages "Type" "posts") "Draft" false -}}
  {{- $index = $index | append (dict
    "id" .RelPermalink
    "title" .Title
    "content" (replaceRE `\s+` " " .Plain | chomp)
    "tags" (.Params.tags | default slice)
    "html" (.Render "summary")
  ) -}}
{{- end -}}

{{- $index | jsonify -}}
