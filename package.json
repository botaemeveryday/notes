{
  "name": "notes-theme",
  "version": "3.0.0",
    "description": "A custom Hugo theme for lecture notes.",
  "repository": "https://github.com/botaemeveryday/notes",
  "author": "notakeith (https://github.com/notakeith)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i ./src/input.css -o ./assets/css/output.css",
    "js": "babel src --out-dir assets --presets=@babel/preset-env --no-comments",
    "build": "npm run css && npm run js",
    "watch": "conc \"npm:css -- -w\" \"npm:js -- -w\""
  },
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@tailwindcss/cli": "^4.0.14",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "daisyui": "^5.7.16",
    "postcss": "^8.5.14"
  },
  "dependencies": {
    "tailwindcss": "^4.3.0"
  }
}
